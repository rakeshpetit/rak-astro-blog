---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import Home from "../components/home.astro";
import "../styles/tailwind.css";
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Rakesh Arun</title>
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-gray-900 antialiased">
    <Header />
    <main class="relative flex-grow overflow-hidden">
      <!-- Background highlights -->
      <div class="absolute -top-24 left-1/2 -z-10 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-blue-50/50 blur-3xl"></div>
      <div class="absolute top-1/2 left-0 -z-10 h-[300px] w-[300px] -translate-y-1/2 rounded-full bg-indigo-50/30 blur-3xl"></div>
      
      <Home />
    </main>
    <Footer />
  </body>
</html>
