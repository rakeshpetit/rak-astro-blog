---
import Header from "../../components/header.astro";
import Footer from "../../components/footer.astro";
import "../../styles/tailwind.css";

import { getCollection } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const shorts = await getCollection("shorts");
  return shorts.map((short) => ({
    params: { slug: short.data.slug || short.slug },
    props: { short },
  }));
}
const { short } = Astro.props;
const { Content } = await short.render();
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{short.data.title} | Rakesh Arun</title>
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-gray-900 antialiased">
    <Header />
    <main class="mx-auto w-full max-w-2xl flex-grow px-4 py-16 sm:px-6 lg:px-8">
      <div class="mb-12 text-center">
        <a 
          href="/shorts" 
          class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700"
        >
          <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to shorts
        </a>
        <header class="mt-8">
          <time 
            datetime={short.data.date}
            class="text-xs font-semibold uppercase tracking-wider text-blue-600"
          >
            {new Date(short.data.date).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
            {short.data.title}
          </h1>
        </header>
      </div>

      <div class="rounded-3xl bg-gray-50 p-8 sm:p-12">
        <article class="prose prose-blue max-w-none prose-p:text-gray-700">
          <Content />
        </article>
      </div>
    </main>
    <Footer />
  </body>
</html>
