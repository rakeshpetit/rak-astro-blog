---
import Header from "../../components/header.astro";
import Footer from "../../components/footer.astro";
import "../../styles/tailwind.css";

import { getCollection } from "astro:content";

const shorts = await getCollection("shorts");
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Shorts | Rakesh Arun</title>
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-gray-900 antialiased">
    <Header />
    <main class="mx-auto w-full max-w-4xl flex-grow px-4 py-16 sm:px-6 lg:px-8">
      <header class="mb-12">
        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">Shorts</h1>
        <p class="mt-4 text-xl text-gray-600">Bite-sized notes, updates, and quick tips.</p>
      </header>

      <div class="grid gap-8 sm:grid-cols-2">
        {
          shorts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).map((short) => {
            return (
              <article class="group relative flex flex-col items-start rounded-2xl border border-gray-100 bg-white p-8 transition-all hover:border-blue-100 hover:shadow-lg hover:shadow-blue-500/5">
                <time 
                  datetime={short.data.date}
                  class="flex items-center text-xs font-bold uppercase tracking-widest text-gray-400 group-hover:text-blue-500 transition-colors"
                >
                  {new Date(short.data.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </time>
                <h2 class="mt-4 text-xl font-bold text-gray-900">
                  <a href={`/shorts/${short.data.slug || short.slug}`}>
                    <span class="absolute inset-0 z-20 rounded-2xl" />
                    <span class="relative z-10">{short.data.title}</span>
                  </a>
                </h2>
                <div class="relative z-10 mt-6 flex items-center text-sm font-bold text-blue-600 pointer-events-none">
                  Read more
                  <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </article>
            );
          })
        }
      </div>
    </main>
    <Footer />
  </body>
</html>
