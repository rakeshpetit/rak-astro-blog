---
import Header from "../../components/header.astro";
import Footer from "../../components/footer.astro";
import Company from "./company.astro";
import TestAccordion from "../../layouts/accordion.astro";
import "../../styles/tailwind.css";

import { getEntry } from "astro:content";

const profile = await getEntry("profile", "intro");
if (!profile) {
  return new Response(null, {
    status: 404,
    statusText: 'Not found'
  });
}
const { Content } = await profile.render();
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Profile | Rakesh Arun</title>
  </head>
  <body class="flex min-h-screen flex-col bg-gray-50 font-sans text-gray-900 antialiased">
    <Header />
    <main class="mx-auto w-full max-w-5xl flex-grow px-4 py-16 sm:px-6 lg:px-8">
      <section class="mb-20">
        <div class="flex flex-col items-center gap-12 lg:flex-row">
          <div class="relative shrink-0">
            <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-600 opacity-75 blur"></div>
            <img
              class="relative h-48 w-48 rounded-full border-4 border-white object-cover shadow-xl lg:h-64 lg:w-64"
              alt="Rakesh Arun"
              src="https://res.cloudinary.com/dcrbjmmo4/image/upload/c_fill,h_300,w_300/v1707230660/Rakesh_Arun__slack.jpg"
            />
          </div>
          <div>
            <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
              {profile.data.title}
            </h1>
            <div class="mt-6 prose prose-blue max-w-none prose-p:text-xl prose-p:leading-relaxed text-gray-600">
              <Content />
            </div>
          </div>
        </div>
      </section>

      <div class="space-y-6">
        <TestAccordion
          checked
          id="mobileExp"
          title="Mobile Development Experience"
        >
          <article class="prose prose-blue max-w-none py-4">
            <p class="text-lg leading-relaxed text-gray-700">
              With over half a decade in mobile development, I've specialized in building high-performance, cross-platform applications using React Native. My focus is on creating seamless user experiences that feel native while maintaining a clean, maintainable codebase.
            </p>
            <ul>
              <li>Expertise in React Native and the Expo ecosystem</li>
              <li>Strong focus on performance optimization and animations</li>
              <li>Experience with native modules and integration</li>
              <li>Building robust architectures for large-scale apps</li>
            </ul>
          </article>
        </TestAccordion>

        <TestAccordion
          id="previousExp"
          title="Experience Prior to Mobile"
        >
          <div class="py-4">
            <Company />
          </div>
        </TestAccordion>
      </div>
    </main>
    <Footer />
  </body>
</html>
