---
import Header from "../../components/header.astro";
import Footer from "../../components/footer.astro";
import "../../styles/tailwind.css";

import { getCollection } from "astro:content";

const posts = await getCollection("posts");
---

<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Posts | Rakesh Arun</title>
  </head>
  <body class="flex min-h-screen flex-col bg-gray-50 font-sans text-gray-900 antialiased">
    <Header />
    <main class="mx-auto w-full max-w-4xl flex-grow px-4 py-16 sm:px-6 lg:px-8">
      <header class="mb-12">
        <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">Blog Posts</h1>
        <p class="mt-4 text-xl text-gray-600">Thoughts on mobile development, web technologies, and more.</p>
      </header>

      <div class="grid gap-12">
        {
          posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).map((post) => {
            return (
              <article class="group relative flex flex-col items-start">
                <time 
                  datetime={post.data.date}
                  class="flex items-center text-sm text-gray-400"
                >
                  <span class="mr-3 h-4 w-0.5 rounded-full bg-gray-200"></span>
                  {new Date(post.data.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
                <h2 class="mt-4 text-2xl font-bold tracking-tight text-gray-900 group-hover:text-blue-600 transition-colors">
                  <a href={`/posts/${post.data.slug || post.slug}`}>
                    <span class="absolute -inset-y-6 -inset-x-4 z-20 sm:-inset-x-6 sm:rounded-2xl" />
                    <span class="relative z-10">{post.data.title}</span>
                  </a>
                </h2>
                <div class="relative z-10 mt-4 flex items-center text-sm font-semibold text-blue-600 pointer-events-none">
                  Read article
                  <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </article>
            );
          })
        }
      </div>
    </main>
    <Footer />
  </body>
</html>
